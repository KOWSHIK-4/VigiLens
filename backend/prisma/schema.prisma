generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemSettingCategory {
  general
  security
  ai_detection
  notifications
  cameras
  storage
  email
  backup
}

enum UserStatus {
  active
  disabled
}

enum DetectionStatus {
  critical
  warning
  info
}

enum AlertSeverity {
  info
  warning
  critical
}

enum CameraStatus {
  online
  offline
  connecting
  error
}

enum CameraType {
  usb
  rtsp
  ip
  video_file
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  name                String
  role                String     @default("operator")
  roleRelation        Role       @relation(fields: [role], references: [name], onDelete: Restrict, onUpdate: Cascade)
  status              UserStatus @default(active)
  avatar              String?
  isLocked            Boolean    @default(false) @map("is_locked")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedAt            DateTime?  @map("locked_at")
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  lastLogin           DateTime?  @map("last_login")
  deletedAt           DateTime?  @map("deleted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@index([role])
  @@index([status])
  @@index([lastLogin])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  name        String           @id
  description String           @default("")
  isSystem    Boolean          @default(true) @map("is_system")
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String           @default("")
  category    String           @default("general")
  roles       RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  role         String       @map("role_name")
  permissionId String       @map("permission_id")
  roleRelation Role         @relation(fields: [role], references: [name], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

model Camera {
  id             String       @id @default(uuid())
  name           String
  url            String
  cameraType     CameraType   @default(rtsp) @map("camera_type")
  sourceURL      String?      @map("source_url")
  location       String?
  resolution     String?
  fps            Int?
  username       String?
  password       String?
  thumbnail      String?
  isHealthy      Boolean      @default(true) @map("is_healthy")
  lastHealthCheck DateTime?   @map("last_health_check")
  status         CameraStatus @default(offline)
  lastSeen       DateTime     @default(now()) @map("last_seen")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  detections     Detection[]
  healthLogs     CameraHealthLog[]
  detectorAssignments DetectorCamera[]

  @@map("cameras")
}

model CameraHealthLog {
  id           String       @id @default(uuid())
  cameraId     String       @map("camera_id")
  status       CameraStatus
  message      String?
  responseTime Int?         @map("response_time")
  checkedAt    DateTime     @default(now()) @map("checked_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
  @@index([checkedAt])
  @@map("camera_health_logs")
}

model Detection {
  id               String           @id @default(uuid())
  cameraId         String           @map("camera_id")
  label            String
  confidence       Float
  status           DetectionStatus  @default(info)
  imageUrl         String           @map("image_url")
  metadata         Json?
  timestamp        DateTime         @default(now())
  createdAt        DateTime         @default(now()) @map("created_at")

  // Detector Engine v2 fields (all optional for backward compatibility).
  detectorId       String?          @map("detector_id")
  detectorKey      String?          @map("detector_key")
  modelVersion     String?          @map("model_version")
  trackId          String?          @map("track_id")
  className        String?          @map("class_name")
  boundingBox      Json?            @map("bounding_box")
  snapshotUrl      String?          @map("snapshot_url")
  processingTimeMs Int?             @map("processing_time_ms")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  alert  Alert?

  @@index([cameraId])
  @@index([status])
  @@index([timestamp])
  @@index([detectorKey])
  @@index([trackId])
  @@map("detections")
}

model Alert {
  id          String        @id @default(uuid())
  detectionId String        @unique @map("detection_id")
  severity    AlertSeverity @default(info)
  title       String
  message     String
  isRead      Boolean       @default(false) @map("is_read")
  createdAt   DateTime      @default(now()) @map("created_at")

  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@map("alerts")
}

enum ReportType {
  daily
  weekly
  monthly
  camera
  detection
  alert
}

enum ReportStatus {
  generating
  completed
  failed
}

model Report {
  id          String       @id @default(uuid())
  title       String
  type        ReportType
  generatedBy String       @map("generated_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  dateRange   Json         @map("date_range")
  reportUrl   String?      @map("report_url")
  status      ReportStatus @default(generating)

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

enum AuditLogAction {
  user_login
  user_logout
  password_reset
  password_changed
  user_created
  user_updated
  user_deleted
  user_locked
  user_unlocked
  role_changed
  role_created
  role_updated
  role_deleted
  camera_added
  camera_updated
  camera_deleted
  camera_started
  camera_stopped
  ai_model_enabled
  ai_model_disabled
  ai_model_updated
  detection_created
  detection_deleted
  detector_created
  detector_updated
  detector_deleted
  detector_enabled
  detector_disabled
  detector_config_updated
  detector_cameras_updated
  monitor_started
  monitor_stopped
  alert_created
  report_generated
  settings_changed
}

enum AuditLogStatus {
  success
  failed
}

enum ModelStatus {
  loaded
  loading
  disabled
  error
}

enum ProcessorPreference {
  gpu
  cpu
  auto
}

model AIModel {
  id                 String      @id @default(uuid())
  name               String
  version            String
  description        String
  detectorKey        String      @unique @map("detector_key")
  confidenceThreshold Float      @default(50) @map("confidence_threshold")
  enabled            Boolean     @default(true)
  status             ModelStatus @default(disabled)
  gpuSupported       Boolean     @default(false) @map("gpu_supported")
  modelPath          String      @map("model_path")
  lastRestartAt      DateTime?   @map("last_restart_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  settings           DetectorSettings?
  cameraAssignments  DetectorCamera[]

  @@index([status])
  @@index([enabled])
  @@map("ai_models")
}

model DetectorSettings {
  id                  String              @id @default(uuid())
  aiModelId           String              @unique @map("ai_model_id")
  alertSeverity       AlertSeverity       @default(info) @map("alert_severity")
  detectionIntervalMs Int                 @default(5000) @map("detection_interval_ms")
  alertCooldownMs     Int                 @default(30000) @map("alert_cooldown_ms")
  preferredProcessor  ProcessorPreference @default(auto) @map("preferred_processor")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  aiModel AIModel @relation(fields: [aiModelId], references: [id], onDelete: Cascade)

  @@map("detector_settings")
}

model DetectorCamera {
  id         String   @id @default(uuid())
  aiModelId  String   @map("ai_model_id")
  cameraId   String   @map("camera_id")
  enabled    Boolean  @default(true)
  assignedAt DateTime @default(now()) @map("assigned_at")

  aiModel AIModel @relation(fields: [aiModelId], references: [id], onDelete: Cascade)
  camera  Camera  @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@unique([aiModelId, cameraId])
  @@index([cameraId])
  @@map("detector_cameras")
}

model SystemSetting {
  id          String                 @id @default(uuid())
  category    SystemSettingCategory
  key         String
  label       String
  description String                 @default("")
  value       Json
  updatedBy   String?                @map("updated_by")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  @@unique([category, key])
  @@index([category])
  @@map("system_settings")
}

model AuditLog {
  id          String          @id @default(uuid())
  timestamp   DateTime        @default(now())
  userId      String?         @map("user_id")
  username    String          @default("")
  email       String          @default("")
  action      AuditLogAction
  module      String
  description String
  ipAddress   String          @default("") @map("ip_address")
  userAgent   String          @default("") @map("user_agent")
  status      AuditLogStatus  @default(success)
  metadata    Json?

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([status])
  @@index([timestamp])
  @@index([email])
  @@map("audit_logs")
}
