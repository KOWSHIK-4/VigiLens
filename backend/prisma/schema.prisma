generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleValue {
  super_admin
  admin
  operator
  viewer
}

enum UserStatus {
  active
  disabled
}

enum DetectionStatus {
  critical
  warning
  info
}

enum AlertSeverity {
  info
  warning
  critical
}

enum CameraStatus {
  online
  offline
  connecting
  error
}

enum CameraType {
  usb
  rtsp
  ip
  video_file
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  role      RoleValue  @default(operator)
  status    UserStatus @default(active)
  avatar    String?
  lastLogin DateTime?  @map("last_login")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([role])
  @@index([status])
  @@index([lastLogin])
  @@map("users")
}

model Role {
  name        RoleValue        @id
  description String           @default("")
  isSystem    Boolean          @default(true) @map("is_system")
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String           @default("")
  category    String           @default("general")
  roles       RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  role         RoleValue    @map("role_name")
  permissionId String       @map("permission_id")
  roleRelation Role         @relation(fields: [role], references: [name], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

model Camera {
  id             String       @id @default(uuid())
  name           String
  url            String
  cameraType     CameraType   @default(rtsp) @map("camera_type")
  sourceURL      String?      @map("source_url")
  location       String?
  resolution     String?
  fps            Int?
  username       String?
  password       String?
  thumbnail      String?
  isHealthy      Boolean      @default(true) @map("is_healthy")
  lastHealthCheck DateTime?   @map("last_health_check")
  status         CameraStatus @default(offline)
  lastSeen       DateTime     @default(now()) @map("last_seen")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  detections     Detection[]
  healthLogs     CameraHealthLog[]

  @@map("cameras")
}

model CameraHealthLog {
  id           String       @id @default(uuid())
  cameraId     String       @map("camera_id")
  status       CameraStatus
  message      String?
  responseTime Int?         @map("response_time")
  checkedAt    DateTime     @default(now()) @map("checked_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
  @@index([checkedAt])
  @@map("camera_health_logs")
}

model Detection {
  id         String           @id @default(uuid())
  cameraId   String           @map("camera_id")
  label      String
  confidence Float
  status     DetectionStatus  @default(info)
  imageUrl   String           @map("image_url")
  metadata   Json?
  timestamp  DateTime         @default(now())
  createdAt  DateTime         @default(now()) @map("created_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  alert  Alert?

  @@index([cameraId])
  @@index([status])
  @@index([timestamp])
  @@map("detections")
}

model Alert {
  id          String        @id @default(uuid())
  detectionId String        @unique @map("detection_id")
  severity    AlertSeverity @default(info)
  title       String
  message     String
  isRead      Boolean       @default(false) @map("is_read")
  createdAt   DateTime      @default(now()) @map("created_at")

  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@map("alerts")
}

enum ReportType {
  daily
  weekly
  monthly
  camera
  detection
  alert
}

enum ReportStatus {
  generating
  completed
  failed
}

model Report {
  id          String       @id @default(uuid())
  title       String
  type        ReportType
  generatedBy String       @map("generated_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  dateRange   Json         @map("date_range")
  reportUrl   String?      @map("report_url")
  status      ReportStatus @default(generating)

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

enum ModelStatus {
  loaded
  loading
  disabled
  error
}

model AIModel {
  id                 String      @id @default(uuid())
  name               String
  version            String
  description        String
  detectorKey        String      @unique @map("detector_key")
  confidenceThreshold Float      @default(50) @map("confidence_threshold")
  enabled            Boolean     @default(true)
  status             ModelStatus @default(disabled)
  gpuSupported       Boolean     @default(false) @map("gpu_supported")
  modelPath          String      @map("model_path")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([enabled])
  @@map("ai_models")
}
