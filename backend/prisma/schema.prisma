generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemSettingCategory {
  general
  security
  ai_detection
  notifications
  cameras
  storage
  email
  backup
}

enum UserStatus {
  active
  disabled
}

enum DetectionStatus {
  critical
  warning
  info
}

enum AlertSeverity {
  info
  warning
  critical
}

enum CameraStatus {
  online
  offline
  connecting
  error
}

enum CameraType {
  usb
  rtsp
  ip
  video_file
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  teams           Team[]
  cameras         Camera[]
  detections      Detection[]
  alerts          Alert[]
  incidents       Incident[]
  reports         Report[]
  auditLogs       AuditLog[]
  teamInvitations TeamInvitation[]

  @@map("organizations")
}

model Team {
  id             String   @id @default(uuid())
  name           String
  description    String   @default("")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  members      User[]           @relation("TeamMembers")
  invitations  TeamInvitation[]
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("teams")
}

enum TeamInvitationStatus {
  pending
  accepted
  revoked
  expired
}

model TeamInvitation {
  id             String               @id @default(uuid())
  tokenHash      String               @unique @map("token_hash")
  email          String
  status         TeamInvitationStatus @default(pending)
  expiresAt      DateTime             @map("expires_at")
  acceptedAt     DateTime?            @map("accepted_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  teamId         String               @map("team_id")
  inviterUserId  String               @map("inviter_user_id")
  organizationId String               @map("organization_id")

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter      User         @relation("TeamInvitationInviters", fields: [inviterUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([organizationId])
  @@index([status])
  @@map("team_invitations")
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  name                String
  role                String     @default("operator")
  roleRelation        Role       @relation(fields: [role], references: [name], onDelete: Restrict, onUpdate: Cascade)
  status              UserStatus @default(active)
  avatar              String?
  isLocked            Boolean    @default(false) @map("is_locked")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedAt            DateTime?  @map("locked_at")
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  tokenVersion        Int        @default(0) @map("token_version")
  lastLogin           DateTime?  @map("last_login")
  deletedAt           DateTime?  @map("deleted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  organizationId      String     @map("organization_id")
  teamId              String?    @map("team_id")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?            @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  incidents      Incident[]
  invitationsOut TeamInvitation[] @relation("TeamInvitationInviters")

  @@index([role])
  @@index([status])
  @@index([lastLogin])
  @@index([deletedAt])
  @@index([organizationId])
  @@index([teamId])
  @@map("users")
}

model Role {
  name        String           @id
  description String           @default("")
  isSystem    Boolean          @default(true) @map("is_system")
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String           @default("")
  category    String           @default("general")
  roles       RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  role         String     @map("role_name")
  permissionId String     @map("permission_id")
  roleRelation Role       @relation(fields: [role], references: [name], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

model Camera {
  id                String       @id @default(uuid())
  name              String
  url               String
  cameraType        CameraType   @default(rtsp) @map("camera_type")
  sourceURL         String?      @map("source_url")
  location          String?
  resolution        String?
  fps               Int?
  username          String?
  password          String?
  usernameEncrypted String?      @map("username_encrypted")
  passwordEncrypted String?      @map("password_encrypted")
  thumbnail         String?
  isHealthy         Boolean      @default(true) @map("is_healthy")
  lastHealthCheck   DateTime?    @map("last_health_check")
  lastSnapshotAt    DateTime?    @map("last_snapshot_at")
  status            CameraStatus @default(offline)
  lastSeen          DateTime     @default(now()) @map("last_seen")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organizationId    String       @map("organization_id")

  detections          Detection[]
  healthLogs          CameraHealthLog[]
  detectorAssignments DetectorCamera[]
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("cameras")
}

model CameraHealthLog {
  id           String       @id @default(uuid())
  cameraId     String       @map("camera_id")
  status       CameraStatus
  message      String?
  responseTime Int?         @map("response_time")
  checkedAt    DateTime     @default(now()) @map("checked_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
  @@index([checkedAt])
  @@map("camera_health_logs")
}

model Detection {
  id             String          @id @default(uuid())
  cameraId       String          @map("camera_id")
  label          String
  confidence     Float
  status         DetectionStatus @default(info)
  imageUrl       String          @map("image_url")
  metadata       Json?
  timestamp      DateTime        @default(now())
  createdAt      DateTime        @default(now()) @map("created_at")
  organizationId String          @map("organization_id")

  // Detector Engine v2 fields (all optional for backward compatibility).
  detectorId       String? @map("detector_id")
  detectorKey      String? @map("detector_key")
  modelVersion     String? @map("model_version")
  trackId          String? @map("track_id")
  className        String? @map("class_name")
  boundingBox      Json?   @map("bounding_box")
  snapshotUrl      String? @map("snapshot_url")
  processingTimeMs Int?    @map("processing_time_ms")

  camera       Camera       @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  alert        Alert?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([cameraId])
  @@index([status])
  @@index([timestamp])
  @@index([detectorKey])
  @@index([trackId])
  @@index([organizationId])
  // Per-camera and per-detector history queries filter by the leading
  // column and order by timestamp DESC; composites avoid a sort step.
  @@index([cameraId, timestamp(sort: Desc)])
  @@index([detectorKey, timestamp(sort: Desc)])
  @@index([status, timestamp(sort: Desc)], map: "detections_status_timestamp_idx")
  @@map("detections")
}

model Alert {
  id                 String        @id @default(uuid())
  detectionId        String        @unique @map("detection_id")
  severity           AlertSeverity @default(info)
  title              String
  message            String
  isRead             Boolean       @default(false) @map("is_read")
  acknowledgedAt     DateTime?     @map("acknowledged_at")
  acknowledgedById   String?       @map("acknowledged_by_id")
  acknowledgedByName String?       @map("acknowledged_by_name")
  escalatedAt        DateTime?     @map("escalated_at")
  escalatedById      String?       @map("escalated_by_id")
  escalatedByName    String?       @map("escalated_by_name")
  escalationNote     String?       @map("escalation_note")
  createdAt          DateTime      @default(now()) @map("created_at")
  organizationId     String        @map("organization_id")

  detection    Detection    @relation(fields: [detectionId], references: [id], onDelete: Cascade)
  incident     Incident?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Alert list queries filter by is_read/severity and order by created_at DESC.
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@index([organizationId])
  @@index([isRead, createdAt(sort: Desc)], map: "alerts_is_read_created_at_idx")
  @@index([severity, createdAt(sort: Desc)], map: "alerts_severity_created_at_idx")
  @@index([acknowledgedAt])
  @@index([escalatedAt])
  @@map("alerts")
}

model Incident {
  id                String         @id @default(uuid())
  alertId           String         @unique @map("alert_id")
  status            IncidentStatus @default(new)
  priority          AlertSeverity  @default(info)
  assignedToUserId  String?        @map("assigned_to_user_id")
  assignedToName    String?        @map("assigned_to_name")
  title             String
  description       String         @default("")
  openedAt          DateTime       @default(now()) @map("opened_at")
  acknowledgedAt    DateTime?      @map("acknowledged_at")
  investigatingAt   DateTime?      @map("investigating_at")
  resolvedAt        DateTime?      @map("resolved_at")
  resolvedById      String?        @map("resolved_by_id")
  resolvedByName    String?        @map("resolved_by_name")
  resolutionSummary String         @default("") @map("resolution_summary")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  organizationId    String         @map("organization_id")

  alert        Alert              @relation(fields: [alertId], references: [id], onDelete: Cascade)
  assignedTo   User?              @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  notes        IncidentNote[]
  activity     IncidentActivity[]
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
  @@index([openedAt])
  @@index([createdAt])
  @@index([organizationId])
  // Incident list queries filter by status/priority/assignee and default to
  // opened_at DESC ordering; composites avoid a sort step per filtered list.
  @@index([status, openedAt(sort: Desc)], map: "incidents_status_opened_at_idx")
  @@index([priority, openedAt(sort: Desc)], map: "incidents_priority_opened_at_idx")
  @@index([assignedToUserId, openedAt(sort: Desc)], map: "incidents_assigned_to_user_id_opened_at_idx")
  @@map("incidents")
}

model IncidentNote {
  id         String   @id @default(uuid())
  incidentId String   @map("incident_id")
  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([createdAt])
  @@index([incidentId, createdAt], map: "incident_notes_incident_id_created_at_idx")
  @@map("incident_notes")
}

model IncidentActivity {
  id         String   @id @default(uuid())
  incidentId String   @map("incident_id")
  action     String
  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  fromValue  String?  @map("from_value")
  toValue    String?  @map("to_value")
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([createdAt])
  @@index([incidentId, createdAt], map: "incident_activity_incident_id_created_at_idx")
  @@map("incident_activity")
}

enum ReportType {
  daily
  weekly
  monthly
  camera
  detection
  alert
}

enum ReportStatus {
  generating
  completed
  failed
}

model Report {
  id             String       @id @default(uuid())
  title          String
  type           ReportType
  generatedBy    String       @map("generated_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  dateRange      Json         @map("date_range")
  reportUrl      String?      @map("report_url")
  status         ReportStatus @default(generating)
  organizationId String       @map("organization_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
  @@map("reports")
}

enum AuditLogAction {
  user_login
  user_logout
  password_reset
  password_changed
  user_created
  user_updated
  user_deleted
  user_locked
  user_unlocked
  role_changed
  role_created
  role_updated
  role_deleted
  camera_added
  camera_updated
  camera_deleted
  camera_started
  camera_stopped
  camera_captured
  ai_model_enabled
  ai_model_disabled
  ai_model_updated
  detection_created
  detection_deleted
  detector_created
  detector_updated
  detector_deleted
  detector_enabled
  detector_disabled
  detector_config_updated
  detector_cameras_updated
  monitor_started
  monitor_stopped
  retention_pruned
  alert_created
  alert_acknowledged
  alert_escalated
  report_generated
  settings_changed
  incident_created
  incident_status_changed
  incident_assigned
  incident_unassigned
  incident_note_added
  incident_reopened
  incident_resolved
  team_created
  team_updated
  team_deleted
  team_member_assigned
  team_member_removed
  team_invitation_created
  team_invitation_revoked
  team_invitation_accepted
}

enum AuditLogStatus {
  success
  failed
}

enum IncidentStatus {
  new
  acknowledged
  investigating
  resolved
  reopened
}

enum ModelStatus {
  loaded
  loading
  disabled
  error
}

enum ProcessorPreference {
  gpu
  cpu
  auto
}

model AIModel {
  id                  String      @id @default(uuid())
  name                String
  version             String
  description         String
  detectorKey         String      @unique @map("detector_key")
  confidenceThreshold Float       @default(50) @map("confidence_threshold")
  enabled             Boolean     @default(true)
  status              ModelStatus @default(disabled)
  gpuSupported        Boolean     @default(false) @map("gpu_supported")
  modelPath           String      @map("model_path")
  lastRestartAt       DateTime?   @map("last_restart_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  settings          DetectorSettings?
  cameraAssignments DetectorCamera[]

  @@index([status])
  @@index([enabled])
  @@map("ai_models")
}

model DetectorSettings {
  id                  String              @id @default(uuid())
  aiModelId           String              @unique @map("ai_model_id")
  alertSeverity       AlertSeverity       @default(info) @map("alert_severity")
  detectionIntervalMs Int                 @default(5000) @map("detection_interval_ms")
  alertCooldownMs     Int                 @default(30000) @map("alert_cooldown_ms")
  preferredProcessor  ProcessorPreference @default(auto) @map("preferred_processor")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  aiModel AIModel @relation(fields: [aiModelId], references: [id], onDelete: Cascade)

  @@map("detector_settings")
}

model DetectorCamera {
  id         String   @id @default(uuid())
  aiModelId  String   @map("ai_model_id")
  cameraId   String   @map("camera_id")
  enabled    Boolean  @default(true)
  assignedAt DateTime @default(now()) @map("assigned_at")

  aiModel AIModel @relation(fields: [aiModelId], references: [id], onDelete: Cascade)
  camera  Camera  @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@unique([aiModelId, cameraId])
  @@index([cameraId])
  @@map("detector_cameras")
}

model SystemSetting {
  id          String                @id @default(uuid())
  category    SystemSettingCategory
  key         String
  label       String
  description String                @default("")
  value       Json
  updatedBy   String?               @map("updated_by")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  createdAt   DateTime              @default(now()) @map("created_at")

  @@unique([category, key])
  @@index([category])
  @@map("system_settings")
}

model AuditLog {
  id             String         @id @default(uuid())
  timestamp      DateTime       @default(now())
  userId         String?        @map("user_id")
  username       String         @default("")
  email          String         @default("")
  action         AuditLogAction
  module         String
  description    String
  ipAddress      String         @default("") @map("ip_address")
  userAgent      String         @default("") @map("user_agent")
  status         AuditLogStatus @default(success)
  metadata       Json?
  hash           String?
  organizationId String?        @map("organization_id")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([status])
  @@index([timestamp])
  @@index([email])
  @@index([organizationId])
  // Audit log lists filter by action/user/status and order by timestamp DESC.
  @@index([action, timestamp(sort: Desc)], map: "audit_logs_action_timestamp_idx")
  @@index([userId, timestamp(sort: Desc)], map: "audit_logs_user_id_timestamp_idx")
  @@index([status, timestamp(sort: Desc)], map: "audit_logs_status_timestamp_idx")
  @@map("audit_logs")
}
