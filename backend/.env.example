# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=vigilens
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=vigilens

# ─── Backend ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vigilens:change_me_in_production@localhost:5432/vigilens

# IMPORTANT: Generate a strong random secret for production.
# Never use the default value in a live deployment.
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# IMPORTANT: Generate a strong random key for production.
# The AI service must send the same value as X-Internal-Key.
# Never use the default value in a live deployment.
INTERNAL_API_KEY=change_me_in_production

# IMPORTANT: 32-byte key (64 hex chars or base64) used to AES-256-GCM
# encrypt camera/NVR stream credentials at rest. Required in production —
# without it the server refuses to start and credential writes fail.
# Generate one with: openssl rand -hex 32
# CAMERA_CREDENTIALS_KEY=
# Optional previous key to keep decrypting rows written before a key rotation.
# CAMERA_CREDENTIALS_KEY_LEGACY=

# Auto-start the continuous monitoring scheduler at boot (default: off).
# MONITOR_ENABLED=false
# MONITOR_TICK_MS=1000
