PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:4000

# IMPORTANT: Must match the backend INTERNAL_API_KEY to ingest webcam detections.
# Generate a strong random key for production; never use the default value.
BACKEND_INTERNAL_KEY=change_me_in_production

# All machine-to-machine endpoints — /capture, /detect/image, /detect/video,
# /detect/detectors, /detect/webcam and /detect/webcam/stats — require the
# X-Internal-Key header whenever the environment is production OR the shared
# secret differs from the bundled development default. This flag forces the
# check on even in development.
# Set to "false" only to open the endpoints for local dev tooling.
# AI_REQUIRE_AUTH=true
#
# NOTE: AI_REQUIRE_AUTH is the canonical flag. The legacy alias
# AI_STATS_REQUIRE_AUTH is still honored for backward compatibility but should
# not be used in new deployments.

# Comma-separated list of allowed CORS origins for the AI service.
# In production this is required and the server will refuse to start without
# an explicit allow-list; a wildcard '*' is never honored in production.
# Leave empty to allow all origins (development mode).
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# Maximum seconds a single model inference call may take before it is aborted.
# The backend applies its own client-side timeout; this bounds the server-side
# work so a stalled model cannot block the event loop indefinitely.
# INFERENCE_TIMEOUT_S=30

# Number of inference retries on transient failures (model errors, timeouts)
# before the request fails. Backoff grows exponentially between attempts.
# INFERENCE_MAX_RETRIES=2
