PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:4000

# IMPORTANT: Must match the backend INTERNAL_API_KEY to ingest webcam detections.
# Generate a strong random key for production; never use the default value.
BACKEND_INTERNAL_KEY=change_me_in_production

# Set to "false" to disable X-Internal-Key check on the webcam stats endpoint
# in development. In production the check is always enforced.
# AI_STATS_REQUIRE_AUTH=true

# Comma-separated list of allowed CORS origins for the AI service.
# Leave empty to allow all origins (development mode).
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com
