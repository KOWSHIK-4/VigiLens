# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=vigilens
POSTGRES_PASSWORD=vigilens_secret
POSTGRES_DB=vigilens

# ─── Backend ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vigilens:vigilens_secret@localhost:5432/vigilens
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Shared secret for machine-to-machine ingestion (AI service -> backend).
# The AI service must send the same value as `X-Internal-Key`.
INTERNAL_API_KEY=dev-internal-key-change-in-production

# 32-byte key (64 hex chars or base64) used to AES-256-GCM encrypt camera
# credentials at rest. REQUIRED for the docker-compose backend — compose
# refuses to start without it. Generate one with: openssl rand -hex 32
CAMERA_CREDENTIALS_KEY=change_me_to_a_random_32_byte_key

# Auto-start the continuous monitoring scheduler at boot (default: off).
# MONITOR_ENABLED=false
# MONITOR_TICK_MS=1000

# ─── Frontend ────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000

# ─── AI Service ──────────────────────────────────────────
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
# Base directory for relative video_file camera paths in /capture.
# MEDIA_ROOT=/data/vigilens/media
# CAPTURE_OPEN_TIMEOUT_MS=5000
# Must match the backend INTERNAL_API_KEY to ingest webcam detections.
BACKEND_INTERNAL_KEY=dev-internal-key-change-in-production
# Gate the AI service webcam stream / stats endpoints behind the key
# (default on in the docker deployment).
AI_STATS_REQUIRE_AUTH=true
