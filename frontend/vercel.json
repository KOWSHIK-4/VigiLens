{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/vercel-test-redirect", "destination": "https://example.com/", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Vercel-Config-Test", "value": "frontend-vercel-json-read" } ] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://vigilens-api.vercel.app/api/:path*" },
    { "source": "/health/:path*", "destination": "https://vigilens-api.vercel.app/health/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}